# ==========================================================================
#  orderflow-signals :: secrets  (chmod 600, never commit)
# ==========================================================================

# --- Binance USDT-M Futures --------------------------------------------
# READ-ONLY key. Enable "Futures" read scope only.
# Disable trading + withdrawals. Whitelist this VPS's static IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Public market data works without keys; keys only raise your REST weight
# ceiling and unlock account-scoped endpoints. Leave blank to run keyless.

# --- Telegram ------------------------------------------------------------
# From @BotFather. Chat ID from @userinfobot, or -100... for a channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# --- Runtime -------------------------------------------------------------
OFS_ENV=production
OFS_LOG_LEVEL=INFO
